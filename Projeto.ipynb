     "text": [
      "Melhor configuracao selecionada pelo K-Fold:\n",
      "Modelo: Random Forest\n",
      "n_sintetico: 220052\n",
      "Hiperparametros: {'class_weight': None, 'max_depth': 10, 'min_samples_leaf': 1, 'n_estimators': 200, 'n_jobs': -1, 'random_state': 4267}\n",
