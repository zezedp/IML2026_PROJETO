        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "def results_to_dataframe(resultados):\n",
        "    linhas = []\n",
        "\n",
        "    for modelo, resultados_modelo in resultados.items():\n",
        "        for n_sintetico, valores in resultados_modelo.items():\n",
        "\n",
        "            linha = {\n",
        "                \"modelo\": modelo,\n",
        "                \"n_sintetico\": n_sintetico,\n",
        "            }\n",
        "\n",
        "            # médias\n",
        "            linha.update(valores[\"mean\"])\n",
        "\n",
        "            # desvios-padrão\n",
        "            for metrica, std in valores[\"std\"].items():\n",
        "                linha[f\"{metrica}_std\"] = std\n",
        "\n",
        "            linhas.append(linha)\n",
        "\n",
        "    return pd.DataFrame(linhas)\n",
        "\n",
        "\n",
        "def plot_metrics(results, title_suffix=\"\", baseline_results=None):\n",
        "\n",
        "    if isinstance(results, dict):\n",
        "        results = results_to_dataframe(results)\n",
        "\n",
        "    sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "    metricas = [\n",
        "        \"accuracy\",\n",
        "        \"precision\",\n",
        "        \"recall\",\n",
        "        \"f1_score\",\n",
        "        \"pr_auc\",\n",
        "        \"roc_auc\",\n",
        "    ]\n",
        "\n",
        "    fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    modelos = sorted(results[\"modelo\"].unique())\n",
        "    cores = sns.color_palette(\"tab10\", n_colors=len(modelos))\n",
        "\n",
        "    for ax, metrica in zip(axes, metricas):\n",
        "\n",
        "        for cor, modelo in zip(cores, modelos):\n",
        "\n",
        "            dados = (\n",
        "                results[results[\"modelo\"] == modelo]\n",
        "                .sort_values(\"n_sintetico\")\n",
        "            )\n",
        "\n",
        "            ax.errorbar(\n",
        "                dados[\"n_sintetico\"],\n",
        "                dados[metrica],\n",
        "                yerr=dados[f\"{metrica}_std\"],\n",
        "                marker=\"o\",\n",
        "                linewidth=2,\n",
        "                markersize=6,\n",
        "                capsize=4,\n",
        "                color=cor,\n",
        "                label=modelo,\n",
        "            )\n",
        "            if (baseline_results is not None):\n",
        "                ax.axhline(\n",
        "                    baseline_results[modelo][\"mean\"][metrica],\n",
        "                    color=cor,\n",
        "                    linestyle=\":\",\n",
        "                    linewidth=2,\n",
        "                    alpha=0.9\n",
        "                )\n",
        "        ax.set_title(metrica.replace(\"_\", \" \").title())\n",
        "        ax.set_xlabel(\"Número de amostras sintéticas\")\n",
        "        ax.set_ylabel(metrica)\n",
        "\n",
        "    handles, labels = axes[0].get_legend_handles_labels()\n",
        "    fig.legend(\n",
        "        handles,\n",
        "        labels,\n",
        "        loc=\"upper center\",\n",
        "        ncol=len(modelos),\n",
        "        bbox_to_anchor=(0.5, 0.945),\n",
        "        fontsize=11,\n",
        "    )\n",
        "\n",
        "    fig.suptitle(\n",
        "        f\"Métricas de Avaliação (n_sintético vs Métricas) {title_suffix}\",\n",
        "        fontsize=16,\n",
        "    )\n",
        "\n",
        "    plt.tight_layout(rect=[0, 0, 1, 0.94])\n",
        "    plt.show()"
      ]
    },
