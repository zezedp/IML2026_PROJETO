        "# Treino com dados sintéticos\n",
        "import pandas as pd\n",
        "from sklearn.metrics import confusion_matrix\n",
        "def train_with_synthetic(X_train, y_train, independent=False):\n",
        "    \"\"\"\n",
        "    Treina modelos COM dados sintéticos e retorna métricas de avaliação.\n",
        "    \"\"\"\n",
        "    modelos = ['LDA', 'QDA', 'Random Forest', 'Logistic Regression']\n",
        "    resultados = {}\n",
        "\n",
        "    for nome in modelos:\n",
        "\n",
        "        resultados[nome] = {}\n",
        "        print(f\"Treinando modelo: {nome}\")\n",
        "        modelo = criar_modelo(nome)\n",
        "\n",
        "        for i, n_sintetico in enumerate(n_sintetico_candidates):\n",
        "            print(f\" candidate {i}-th, n_sintetico: {n_sintetico}\")\n",
        "            model_metrics = []\n",
        "            y_true_all = []\n",
        "            y_pred_all = []\n",
        "\n",
        "            for train_idx, val_idx in skf.split(X_train, y_train):\n",
        "                X_train_fold = X_train[train_idx]\n",
        "                X_val_fold = X_train[val_idx]\n",
        "\n",
        "                y_train_fold = y_train[train_idx]\n",
        "                y_val_fold = y_train[val_idx]\n",
        "\n",
        "                print(\"\\t Balancing train set with synthetic data...\")\n",
        "                X_train_fold, y_train_fold = balance_train(\n",
        "                    X_train_fold,\n",
        "                    y_train_fold,\n",
        "                    n_sintetico,\n",
        "                    independent=independent\n",
        "                )\n",
        "                print(\"\\t Finished balancing train set.\")\n",
        "                modelo.train(X_train_fold, y_train_fold)\n",
        "\n",
        "                y_pred = modelo.predict(X_val_fold)\n",
        "                y_proba = modelo.predict_probability(X_val_fold)\n",
        "\n",
        "                metrics = modelo.calc_metrics(\n",
        "                    y_val_fold,\n",
        "                    y_pred,\n",
        "                    y_proba\n",
        "                )\n",
        "\n",
        "                model_metrics.append(metrics)\n",
        "\n",
        "                y_true_all.extend(y_val_fold)\n",
        "                y_pred_all.extend(y_pred)\n",
        "\n",
        "            df_metrics = pd.DataFrame(model_metrics)\n",
        "\n",
        "            resultados[nome][n_sintetico] = {\n",
        "                \"folds\": df_metrics,\n",
        "                \"mean\": df_metrics.mean().to_dict(),\n",
        "                \"std\": df_metrics.std(ddof=1).to_dict(),\n",
        "                \"confusion_matrix\": confusion_matrix(\n",
        "                    y_true_all,\n",
        "                    y_pred_all\n",
        "                )\n",
        "            }\n",
        "    return resultados\n"
      ]
    },
