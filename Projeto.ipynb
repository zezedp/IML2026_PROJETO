   "source": [
    "from sklearn.model_selection import ParameterGrid, StratifiedKFold\n",
    "from sklearn.discriminant_analysis import LinearDiscriminantAnalysis, QuadraticDiscriminantAnalysis\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
    "\n",
    "\n",
    "def balancear_com_sinteticos(X_treino_fold, y_treino_fold, n_sintetico):\n",
    "    \"\"\"Gera dados sinteticos somente a partir do treino recebido.\"\"\"\n",
    "    df_treino_fold = pd.DataFrame(\n",
    "        X_treino_fold,\n",
    "        columns=COLUNAS_CONTINUAS + COLUNAS_BINARIAS\n",
    "    )\n",
    "    df_treino_fold[\"fraud\"] = y_treino_fold\n",
    "    fraud_data_fold = df_treino_fold[df_treino_fold[\"fraud\"] == 1.0]\n",
    "\n",
    "    X_cont_sintetico_fold = gen_continuas(fraud_data_fold, n_sintetico)\n",
    "    X_bin_sintetico_fold = gen_binarias(fraud_data_fold, n_sintetico)\n",
    "\n",
    "    df_sintetico_fold = pd.DataFrame(\n",
    "        X_cont_sintetico_fold,\n",
    "        columns=COLUNAS_CONTINUAS\n",
    "    )\n",
    "    for col in COLUNAS_BINARIAS:\n",
    "        df_sintetico_fold[col] = X_bin_sintetico_fold[col]\n",
    "    df_sintetico_fold[\"fraud\"] = 1.0\n",
    "\n",
    "    df_balanceado_fold = pd.concat(\n",
    "        [df_treino_fold, df_sintetico_fold],\n",
    "        ignore_index=True\n",
    "    )\n",
    "\n",
    "    X_balanceado_fold = df_balanceado_fold[COLUNAS_CONTINUAS + COLUNAS_BINARIAS].values\n",
    "    y_balanceado_fold = df_balanceado_fold[\"fraud\"].values\n",
    "    return X_balanceado_fold, y_balanceado_fold\n",
    "\n",
    "\n",
    "def criar_estimador(nome_modelo, parametros):\n",
    "    \"\"\"Cria um estimador sklearn com os hiperparametros selecionados.\"\"\"\n",
    "    if nome_modelo == \"LDA\":\n",
    "        return LinearDiscriminantAnalysis(**parametros)\n",
    "    if nome_modelo == \"QDA\":\n",
    "        return QuadraticDiscriminantAnalysis(**parametros)\n",
    "    if nome_modelo == \"Logistic Regression\":\n",
    "        return LogisticRegression(**parametros)\n",
    "    if nome_modelo == \"Random Forest\":\n",
    "        return RandomForestClassifier(**parametros)\n",
    "    raise ValueError(f\"Modelo desconhecido: {nome_modelo}\")\n",
    "\n",
    "\n",
    "modelos_candidatos = {\n",
    "    \"LDA\": {\n",
    "        \"param_grid\": [{}],\n",
    "    },\n",
    "    \"QDA\": {\n",
    "        \"param_grid\": {\n",
    "            \"reg_param\": [0.0, 0.01, 0.05, 0.1],\n",
    "        },\n",
    "    },\n",
    "    \"Logistic Regression\": {\n",
    "        \"param_grid\": {\n",
    "            \"C\": [0.1, 1.0, 10.0],\n",
    "            \"class_weight\": [None, \"balanced\"],\n",
    "            \"max_iter\": [1000],\n",
    "            \"random_state\": [4267],\n",
    "        },\n",
    "    },\n",
    "    \"Random Forest\": {\n",
    "        \"param_grid\": {\n",
    "            \"n_estimators\": [100, 200],\n",
    "            \"max_depth\": [8, 10, 14],\n",
    "            \"min_samples_leaf\": [1, 5],\n",
    "            \"class_weight\": [None, \"balanced\"],\n",
    "            \"random_state\": [4267],\n",
    "            \"n_jobs\": [-1],\n",
    "        },\n",
    "    },\n",
    "}\n",
    "\n",
    "n_fraudes_treino = (y_train == 1.0).sum()\n",
    "n_legitimas_treino = (y_train == 0.0).sum()\n",
    "desequilibrio_treino = abs(n_legitimas_treino - n_fraudes_treino)\n",
    "\n",
    "n_sintetico_candidatos = sorted({\n",
    "    int(desequilibrio_treino // divisor)\n",
    "    for divisor in [1.0, 1.5, 2.0, 2.5, 3.0]\n",
    "}, reverse=True)\n",
    "\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=4267)\n",
    "resultados_kfold = []\n",
    "\n",
    "for nome_modelo, config_modelo in modelos_candidatos.items():\n",
    "    for parametros in ParameterGrid(config_modelo[\"param_grid\"]):\n",
    "        for n_sintetico_candidato in n_sintetico_candidatos:\n",
    "            metricas_folds = []\n",
    "\n",
    "            for train_idx, val_idx in skf.split(X_train, y_train):\n",
    "                X_fold_train, X_fold_val = X_train[train_idx], X_train[val_idx]\n",
    "                y_fold_train, y_fold_val = y_train[train_idx], y_train[val_idx]\n",
    "\n",
    "                X_fold_train_bal, y_fold_train_bal = balancear_com_sinteticos(\n",
    "                    X_fold_train,\n",
    "                    y_fold_train,\n",
    "                    n_sintetico_candidato\n",
    "                )\n",
    "\n",
    "                modelo = criar_estimador(nome_modelo, parametros)\n",
    "                modelo.fit(X_fold_train_bal, y_fold_train_bal)\n",
    "                y_fold_pred = modelo.predict(X_fold_val)\n",
    "\n",
    "                metricas_folds.append({\n",
    "                    \"accuracy\": accuracy_score(y_fold_val, y_fold_pred),\n",
    "                    \"precision\": precision_score(y_fold_val, y_fold_pred, zero_division=0),\n",
    "                    \"recall\": recall_score(y_fold_val, y_fold_pred, zero_division=0),\n",
    "                    \"f1\": f1_score(y_fold_val, y_fold_pred, zero_division=0),\n",
    "                })\n",
    "\n",
    "            resultados_kfold.append({\n",
    "                \"modelo\": nome_modelo,\n",
    "                \"parametros\": parametros,\n",
    "                \"n_sintetico\": n_sintetico_candidato,\n",
    "                \"accuracy_medio\": np.mean([m[\"accuracy\"] for m in metricas_folds]),\n",
    "                \"precision_medio\": np.mean([m[\"precision\"] for m in metricas_folds]),\n",
    "                \"recall_medio\": np.mean([m[\"recall\"] for m in metricas_folds]),\n",
    "                \"f1_medio\": np.mean([m[\"f1\"] for m in metricas_folds]),\n",
    "                \"f1_desvio\": np.std([m[\"f1\"] for m in metricas_folds]),\n",
    "            })\n",
    "\n",
    "df_resultados_kfold = pd.DataFrame(resultados_kfold).sort_values(\n",
    "    by=[\"f1_medio\", \"recall_medio\", \"precision_medio\"],\n",
    "    ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "melhor_config = df_resultados_kfold.iloc[0]-\n",
    "melhor_modelo_nome = melhor_config[\"modelo\"]\n",
    "melhores_parametros = dict(melhor_config[\"parametros\"])\n",
    "n_sintetico = int(melhor_config[\"n_sintetico\"])\n",
    "\n",
    "melhores_parametros_por_modelo = {\n",
    "    linha[\"modelo\"]: dict(linha[\"parametros\"])\n",
    "    for _, linha in df_resultados_kfold.drop_duplicates(\"modelo\").iterrows()\n",
    "}\n",
    "\n",
    "print(\"Top 10 configuracoes por F1 medio na validacao cruzada:\")\n",
    "display(df_resultados_kfold.head(10))\n",
    "\n",
    "print(\"Melhor configuracao selecionada pelo K-Fold:\")\n",
    "print(f\"Modelo: {melhor_modelo_nome}\")\n",
    "print(f\"n_sintetico: {n_sintetico}\")\n",
    "print(f\"Hiperparametros: {melhores_parametros}\")\n",
    "print(f\"F1 medio: {melhor_config['f1_medio']:.4f} +/- {melhor_config['f1_desvio']:.4f}\")"
   ]
  },
