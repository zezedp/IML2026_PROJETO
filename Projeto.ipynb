      "source": [
        "# Treino sem dados sintéticos\n",
        "import pandas as pd\n",
        "from sklearn.metrics import confusion_matrix\n",
        "def train_baseline(X_train, y_train):\n",
        "    \"\"\"\n",
        "    Treina modelos sem dados sintéticos e retorna métricas de avaliação.\n",
        "    \"\"\"\n",
        "    modelos = ['LDA', 'QDA', 'Random Forest', 'Logistic Regression']\n",
        "    resultados = {}\n",
        "\n",
        "    #col_idx = (COLUNAS_CONTINUAS + COLUNAS_BINARIAS).index(\"ratio_to_median_purchase_price\")\n",
        "\n",
        "    #X_train_drop = np.delete(X_train, col_idx, axis=1)   \n",
        "    for nome in modelos:\n",
        "        modelo = criar_modelo(nome)\n",
        "\n",
        "        model_metrics = []\n",
        "\n",
        "        y_true_all = []\n",
        "        y_pred_all = []\n",
        "\n",
        "        for train_idx, val_idx in skf.split(X_train, y_train):\n",
        "\n",
        "            X_train_fold, X_val_fold = X_train[train_idx], X_train[val_idx]\n",
        "            y_train_fold, y_val_fold = y_train[train_idx], y_train[val_idx]\n",
        "\n",
        "            modelo.train(X_train_fold, y_train_fold)\n",
        "\n",
        "            y_pred = modelo.predict(X_val_fold)\n",
        "            y_proba = modelo.predict_probability(X_val_fold)\n",
        "\n",
        "            metrics = modelo.calc_metrics(y_val_fold, y_pred, y_proba)\n",
        "            model_metrics.append(metrics)\n",
        "\n",
        "            y_true_all.extend(y_val_fold)\n",
        "            y_pred_all.extend(y_pred)\n",
        "\n",
        "        df_metrics = pd.DataFrame(model_metrics)\n",
        "\n",
        "        cm_final = confusion_matrix(y_true_all, y_pred_all)\n",
        "\n",
        "        resultados[nome] = {\n",
        "            \"folds\": df_metrics,\n",
        "            \"mean\": df_metrics.mean().to_dict(),\n",
        "            \"std\": df_metrics.std(ddof=1).to_dict(),\n",
        "            \"confusion_matrix\": cm_final\n",
        "        }\n",
        "\n",
        "    return resultados\n",
        "\n",
        "baseline_results = train_baseline(X_train, y_train)\n",
        "baseline_results"
      ]
    },
