      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "dfs = []\n",
        "\n",
        "for modelo, dados in baseline_results.items():\n",
        "    df_folds = dados[\"folds\"]\n",
        "    df_folds[\"Modelo\"] = modelo\n",
        "    dfs.append(df_folds)\n",
        "metrics = [\"accuracy\", \"precision\", \"recall\", \"f1_score\", \"pr_auc\", \"roc_auc\"]\n",
        "\n",
        "df_box = pd.concat(dfs, ignore_index=True)\n",
        "\n",
        "sns.set_theme(style=\"white\", context=\"paper\")\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(16, 9), dpi=300)\n",
        "axes = axes.flatten()\n",
        "\n",
        "for i, metric in enumerate(metrics):\n",
        "    ax = axes[i]\n",
        "\n",
        "    sns.pointplot(\n",
        "        data=df_box,\n",
        "        x=\"Modelo\",\n",
        "        y=metric,\n",
        "        errorbar=\"sd\",\n",
        "        markers=\"o\",\n",
        "        linestyles=\"-\",\n",
        "        color=\"black\",\n",
        "        err_kws={\"linewidth\": 1.5},\n",
        "        ax=ax\n",
        "    )\n",
        "\n",
        "    ax.set_title(metric.replace(\"_\", \" \").title(), fontsize=11)\n",
        "    ax.set_xlabel(\"\")\n",
        "    ax.set_ylabel(\"\")\n",
        "\n",
        "    ax.set_ylim(0, 1)\n",
        "\n",
        "    ax.grid(True, axis='y', linestyle='--', linewidth=0.4, alpha=0.25)\n",
        "    sns.despine(ax=ax)\n",
        "\n",
        "    ax.tick_params(axis='x', rotation=15, labelsize=9)\n",
        "    ax.tick_params(axis='y', labelsize=9)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
